{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed, idempotent wagering processor for Jungle Gaming's backend challenge.",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun dist/main.js",
    "start:worker": "bun dist/worker-main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:integration": "bun scripts/run-integration-tests.ts",
    "migration:run": "bun src/infrastructure/persistence/run-migrations.ts run",
    "migration:down": "bun src/infrastructure/persistence/run-migrations.ts down",
    "migration:show": "bun src/infrastructure/persistence/run-migrations.ts show",
    "dead-letter": "bun scripts/dead-letter-operations.ts",
    "lint": "biome check src test scripts package.json biome.json tsconfig.json tsconfig.build.json docker-compose.yml Dockerfile",
    "format": "biome format --write src test scripts package.json biome.json tsconfig.json tsconfig.build.json docker-compose.yml Dockerfile"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1148.0",
    "@nestjs/common": "^11.1.2",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.2",
    "@nestjs/platform-express": "^11.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/bun": "^1.2.22",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2"
  }
}
